+def distributed_training():
+    return distributed.is_available() and distributed.is_initialized()
+
+
+def masked_token_mean(values, valid_mask, sync=False):
+    """Mean over valid elements; DDP averaging then yields the global-token mean.
+
+    In eval, sync=False is mandatory so a rank-zero probe can run independently.
+    """
+    selected = values[valid_mask]
+    count = torch.tensor(selected.numel(), device=values.device, dtype=torch.long)
+    world_size = 1
+    if sync and distributed_training():
+        distributed.all_reduce(count)
+        world_size = distributed.get_world_size()
+    return selected.sum() * world_size / count.clamp_min(1)
+
+
+@torch.no_grad()
+def pooled_vectors(local_vectors, samples_per_rank):
+    """Bounded valid-only candidate pool, including ranks with no valid tokens."""
+    if len(local_vectors) > samples_per_rank:
+        local_vectors = sample_vectors(local_vectors, samples_per_rank)
+    if not distributed_training():
+        return local_vectors
+    size = torch.tensor([len(local_vectors)], device=local_vectors.device, dtype=torch.long)
+    sizes = [torch.empty_like(size) for _ in range(distributed.get_world_size())]
+    distributed.all_gather(sizes, size)
+    max_size = max(int(n) for n in sizes)
+    padded = local_vectors.new_zeros(max_size, local_vectors.shape[-1])
+    padded[:len(local_vectors)] = local_vectors
+    gathered = [torch.empty_like(padded) for _ in sizes]
+    distributed.all_gather(gathered, padded)
+    return torch.cat([vectors[:int(n)] for vectors, n in zip(gathered, sizes)])
 
 
