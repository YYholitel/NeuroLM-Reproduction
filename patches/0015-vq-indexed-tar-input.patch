+def read_pickle_sample(location):
+    if not isinstance(location, dict):
+        with open(location, 'rb') as stream:
+            return pickle.load(stream)
+    name = location['shard']
+    if name not in _shard_handles:
+        if len(_shard_handles) >= 16:
+            _shard_handles.popitem(last=False)[1].close()
+        _shard_handles[name] = open(name, 'rb')
+    stream = _shard_handles[name]
+    _shard_handles.move_to_end(name)
+    stream.seek(location['offset'])
+    payload = stream.read(location['size'])
+    if len(payload) != location['size']:
+        raise IOError('Truncated VQ shard: ' + name)
+    return pickle.loads(payload)
 
 
